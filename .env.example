# Public site URL (used for SEO, sitemap, Open Graph). Set to the real domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.co.ke

# Where quote/consultation requests are delivered (Zapier, Make, Google Apps Script, CRM...).
# Without it, the site tells visitors to finish their request via WhatsApp instead.
LEAD_WEBHOOK_URL=

# Britam agent / licence number (shown in footer when set)
NEXT_PUBLIC_AGENT_NUMBER=

# Authorised Britam online purchase URLs. Add ONLY for products where Britam has approved one.
# A "Buy Online" button then appears for that product.
NEXT_PUBLIC_PURCHASE_URL_MOTOR_INSURANCE=
NEXT_PUBLIC_PURCHASE_URL_TRAVEL_INSURANCE=
NEXT_PUBLIC_PURCHASE_URL_MEDICAL_INSURANCE=
NEXT_PUBLIC_PURCHASE_URL_LIFE_INSURANCE=
